+
+# Async dataloader: packing/tokenizing on the CPU is on the critical path when
+# consumed inline in the training loop (it stalls GPU work enqueuing). Run the
+# loader in a background thread and hand batches through a small queue. The
+# loader reuses the same pinned/GPU buffers every step, so the producer copies
+# each batch out before the next one can overwrite it.
+data_q = Queue(maxsize=2)
+stop_prefetch = threading.Event()
+
+def _prefetch_loop(loader, q, stop_evt):
+    while not stop_evt.is_set():
+        x, y, ep = next(loader)
+        q.put((x.clone(), y.clone(), ep))
+
+prefetch_thread = threading.Thread(target=_prefetch_loop, args=(train_loader, data_q, stop_prefetch), daemon=True)
+prefetch_thread.start()
+x, y, epoch = data_q.get()  # first batch
 
 print(f"Time budget: {TIME_BUDGET}s")
 print(f"Gradient accumulation steps: {grad_accum_steps}")
