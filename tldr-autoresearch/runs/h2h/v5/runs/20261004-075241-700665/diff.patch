-x, y, epoch = next(train_loader)  # prefetch first batch
+# Double-buffered prefetch: background thread packs batches and copies them to GPU
+# buffers while the main thread trains on the other buffer (overlaps CPU packing
+# with GPU compute).
+import threading
+import queue
+_bufs = [(torch.empty(DEVICE_BATCH_SIZE * MAX_SEQ_LEN * 2, dtype=torch.long, device="cuda"),
+          torch.cuda.Event()) for _ in range(2)]
+_q = queue.Queue(maxsize=1)
+
+def _prefetch_worker():
+    i = 0
+    while True:
+        x, y, _ = next(train_loader)
+        flat = _bufs[i][0]
+        fx = flat[:DEVICE_BATCH_SIZE * MAX_SEQ_LEN].view(DEVICE_BATCH_SIZE, MAX_SEQ_LEN)
+        fy = flat[DEVICE_BATCH_SIZE * MAX_SEQ_LEN:].view(DEVICE_BATCH_SIZE, MAX_SEQ_LEN)
+        fx.copy_(x)
+        fy.copy_(y)
+        ev = _bufs[i][1]
+        ev.record()
+        _q.put(i)
+        i = 1 - i
+
+_worker = threading.Thread(target=_prefetch_worker, daemon=True)
+_worker.start()
+
+def _get_batch():
+    i = _q.get()
+    _bufs[i][1].synchronize()
+    flat = _bufs[i][0]
+    n = DEVICE_BATCH_SIZE * MAX_SEQ_LEN
+    return flat[:n].view(DEVICE_BATCH_SIZE, MAX_SEQ_LEN), flat[n:].view(DEVICE_BATCH_SIZE, MAX_SEQ_LEN)
+
+x, y = _get_batch()
+epoch = 1
 
 print(f"Time budget: {TIME_BUDGET}s")
