 from prepare import MAX_SEQ_LEN, TIME_BUDGET, Tokenizer, make_dataloader, evaluate_bpb
 
+def make_prefetcher(loader, depth=8):
+    """Run the dataloader in a background thread so CPU packing overlaps with GPU compute.
+    The loader reuses a single GPU buffer, so we clone each batch into private storage."""
+    q = Queue(maxsize=depth)
+    def worker():
+        while True:
+            x, y, epoch = next(loader)
+            q.put((x.clone(), y.clone(), epoch))
+    threading.Thread(target=worker, daemon=True).start()
+    return q.get
+
