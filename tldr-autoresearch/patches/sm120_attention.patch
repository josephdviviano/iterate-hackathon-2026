 import torch.nn as nn
 import torch.nn.functional as F
 
-from kernels import get_kernel
+from torch.nn.attention.flex_attention import flex_attention, create_block_mask
+
+# Attention backend. The kernels-hub FA3 builds only contain sm_80/sm_90a code: on sm_120
+# (RTX PRO 6000 / RTX 50xx) the first call hard-aborts the process ("no kernel image is available").
+# Hopper -> FA3. Everything else -> FlexAttention for sliding-window layers, SDPA for full-causal layers.
 cap = torch.cuda.get_device_capability()
-# varunneal's FA3 is Hopper only, use kernels-community on non-Hopper GPUs
-repo = "varunneal/flash-attention-3" if cap == (9, 0) else "kernels-community/flash-attn3"
-fa3 = get_kernel(repo).flash_attn_interface
+USE_FA3 = cap == (9, 0)
+if USE_FA3:
+    from kernels import get_kernel
+    fa3 = get_kernel("varunneal/flash-attention-3").flash_attn_interface
+_BLOCK_MASKS = {}
+
+def get_block_mask(T, w, device):
+    """Causal sliding-window block mask with FA3 semantics: key j visible to query i iff 0 <= i-j <= w."""
+    if (T, w) not in _BLOCK_MASKS:
+        def sliding_causal(b, h, q_idx, kv_idx):
+            return (q_idx >= kv_idx) & (q_idx - kv_idx <= w)
+        _BLOCK_MASKS[(T, w)] = create_block_mask(sliding_causal, B=None, H=None, Q_LEN=T, KV_LEN=T, device=device)
+    return _BLOCK_MASKS[(T, w)]
+
+def attention(q, k, v, window_size):
+    """q, k, v: (B, T, H, D) -> (B, T, H, D). window_size = (left, right) as in FA3."""
+    if USE_FA3:
+        return fa3.flash_attn_func(q, k, v, causal=True, window_size=window_size)
+    T, w = q.size(1), window_size[0]
+    q, k, v = q.transpose(1, 2), k.transpose(1, 2), v.transpose(1, 2)
+    gqa = q.size(1) != k.size(1)
+    if w < 0 or w >= T:
+        y = F.scaled_dot_product_attention(q, k, v, is_causal=True, enable_gqa=gqa)
+    else:
+        y = flex_attention(q, k, v, block_mask=get_block_mask(T, w, q.device), enable_gqa=gqa)
+    return y.transpose(1, 2)
 
