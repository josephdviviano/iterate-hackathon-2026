{
  "defaultProvider": "rl",
  "defaultModel": "policy",
  "defaultThinkingLevel": "medium",
  "defaultProjectTrust": "never",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "cacheWarming": "off",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 60000,
    "provider": {
      "timeoutMs": 1800000,
      "maxRetries": 0
    }
  },
  "httpIdleTimeoutMs": 1800000
}